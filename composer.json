{
    "name": "streetmesh/laravel",
    "description": "Turns a Laravel application into a StreetMesh server: portable identity, records, and the two halves people live in and gather at.",
    "keywords": [
        "streetmesh",
        "laravel",
        "atproto",
        "did",
        "federation",
        "metaverse"
    ],
    "homepage": "https://protocol.streetmesh.com",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-fileinfo": "*",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "livewire/flux": "^2.13",
        "livewire/livewire": "^4.1",
        "streetmesh/protocol": "@dev"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.4"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../protocol",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/StreetMesh/Protocol-PHP.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "StreetMesh\\Server\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StreetMesh\\Server\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "StreetMesh\\Server\\ServerServiceProvider"
            ]
        },
        "streetmesh": {
            "views": "resources/views",
            "entries": [
                "resources/js/comms/host.js"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "lint": "pint",
        "lint:check": "pint --test",
        "test": [
            "@lint:check",
            "@types:check",
            "phpunit"
        ],
        "types:check": "phpstan analyse"
    },
    "support": {
        "source": "https://github.com/StreetMesh/Laravel"
    }
}
