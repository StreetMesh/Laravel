{
    "name": "{{ package }}",
    "description": "{{ description }}",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "livewire/flux": "^2.13",
        "livewire/livewire": "^4.1",
        "streetmesh/laravel": "^0.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.4"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/StreetMesh/Laravel.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/StreetMesh/Protocol-PHP.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "{{ namespaceJson }}\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "{{ namespaceJson }}\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "{{ namespaceJson }}\\{{ class }}ServiceProvider"
            ]
        },
        "streetmesh": {
            "components": "resources/js/alpine.js",
            "views": "resources/views"{{ npmDependencies }}
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "lint": "pint",
        "lint:check": "pint --test",
        "test": [
            "@lint:check",
            "@types:check",
            "phpunit"
        ],
        "types:check": "phpstan analyse"
    }
}
