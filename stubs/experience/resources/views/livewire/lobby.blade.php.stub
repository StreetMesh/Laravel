<?php

use Livewire\Attributes\Title;
use Livewire\Component;
use StreetMesh\Server\Venue\Visitors;

new
#[Title('{{ title }}')]
class extends Component
{
    /**
     * Whether whoever is reading this arrived with an address.
     *
     * A venue has no accounts, so the framework's own `auth()` knows nothing
     * about them. Looking asks nothing of anybody; doing is what needs a name.
     */
    public function arrived(): bool
    {
        return app(Visitors::class)->current(request()) !== null;
    }
};?>

{{--
    The way in to {{ title }}.

    `data-streetmesh-space` is how the comms widget knows where this screen is,
    so that people looking at the same thing can talk about it. It costs one
    attribute and there is nothing else to wire up.
--}}
<div class="flex flex-col gap-6" data-streetmesh-space="{{ nsid }}/lobby">
    <div class="flex flex-col gap-1">
        <flux:heading size="xl">{{ title }}</flux:heading>
        <flux:subheading>{{ description }}</flux:subheading>
    </div>

    @if (! $this->arrived())
        {{-- Offered rather than demanded. Somebody who only wants to look
             should not meet a form asking them to name their own server. --}}
        <flux:callout icon="hand-raised">
            <flux:callout.heading>{{ __('Come in first') }}</flux:callout.heading>
            <flux:callout.text>
                {{ __('Taking part means arriving with an address your own server issued.') }}
            </flux:callout.text>
            <x-slot name="actions">
                <flux:button :href="route('venue.connect')" size="sm" variant="primary">
                    {{ __('Arrive') }}
                </flux:button>
            </x-slot>
        </flux:callout>
    @else
        <flux:text>{{ __('Nothing here yet. This is where you build it.') }}</flux:text>
    @endif
</div>
